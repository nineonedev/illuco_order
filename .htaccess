# Apache 모듈 활성화 및 심볼릭 링크 허용
<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # 보안: 비공개 디렉토리 접근 차단
    RewriteCond %{REQUEST_URI} ^/config(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/bootstrap(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/storage(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/database(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/framework(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/resources(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/routes(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/vendor(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/env(/|$)
    RewriteRule ^ / [L,R=302]

    # /static/uploads 및 /static/app 접근 허용
    RewriteCond %{REQUEST_URI} ^/static/uploads(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/static/app(/|$)
    RewriteRule ^ - [L]

    # 실제 존재하는 파일 또는 디렉토리는 그대로 처리
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 나머지는 index.php로 라우팅
    RewriteRule ^ index.php [L]
</IfModule>
