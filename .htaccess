RewriteEngine On

# 비공개 서버 내부 폴더 직접 접근 차단 (app 제외)
RewriteRule ^(config|bootstrap|storage|database|framework|resources|routes|vendor|private|env)(/|$) /error/403 [L,R=302]

# /app (공개 업로드 등) 및 /assets 경로는 통과
RewriteCond %{REQUEST_URI} ^/uploads/ [OR]
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^ - [L]

# 실제 파일 또는 디렉토리 요청은 통과
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 나머지 요청은 index.php 로 라우팅
RewriteRule ^ index.php [L]
